{% from "partials/_macros.jinja" import radio_label %}

<dialog class="[animation:fade_0.2s_both] m-auto bg-transparent text-neutral-800 dark:text-neutral-300 backdrop:backdrop-blur-lg backdrop:bg-black/50"
        hx-on::load="this.showModal()" hx-on:close="this.remove()">

    <div class="flex flex-col p-6 px-8 bg-neutral-100 border border-transparent shadow rounded-2xl transition-colors duration-[250ms] dark:bg-neutral-875 dark:border-neutral-200/5">

        <form hx-post="/pizza-orders/add" hx-target="body" hx-swap="beforeend" hx-on::after-request="htmx.find('dialog').close()">

            <p class="text-center font-[600] mb-3">1. Select pizza:</p>
            <div class="flex justify-center items-center gap-2 mb-6">
                {{ radio_label(name='name', value='cheese', label='Cheese', icon_class='icon-[ph--cheese-fill]') }}
                {{ radio_label(name='name', value='pepperoni', label='Pepperoni', icon_class='icon-[mdi--spicy]') }}
                {{ radio_label(name='name', value='vegetarian', label='Vegetarian', icon_class='icon-[ph--plant-fill]') }}
            </div>

            <p class="text-center font-[600] mb-3">2. Select size:</p>
            <div class="flex justify-center items-center gap-1.5 mb-6">
                {{ radio_label(name='size', value='small', label='Small', icon_class='icon-[mdi--size-s]') }}
                {{ radio_label(name='size', value='medium', label='Medium', icon_class='icon-[mdi--size-m]') }}
                {{ radio_label(name='size', value='large', label='Large', icon_class='icon-[mdi--size-l]') }}
            </div>

            <button type="submit" class="w-full dark:text-black bg-orange-500 hover:bg-orange-600 dark:bg-amber-500 dark:hover:bg-amber-400 cursor-pointer inline-flex items-center justify-center px-3 py-1.5 mt-auto rounded-lg transition-colors duration-[250ms] font-[600] whitespace-nowrap">
                Create
            </button>
        </form>
    </div>

    <form method="dialog" class="fixed inset-0 -z-10" hx-on:click="this.submit()"></form>
</dialog>
