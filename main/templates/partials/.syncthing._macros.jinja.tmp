{# Reusable Jinja2 macros for chat, toggles, pizza UI.
   Icons use the @iconify/tailwind4 plugin. Pattern: icon dash open-bracket
   prefix dash dash name close-bracket as a utility class. #}

{% macro chat_message(role, content, extra_class='', id='') %}
<div {% if id %}id="{{ id }}"{% endif %}
     class="chat-message inline-flex items-end mb-4 gap-3 sm:fullscreen:mb-6 {% if role == 'assistant' %}flex-row{% else %}flex-row-reverse{% endif %} {{ extra_class }}">
    {% if role == 'assistant' %}
    <img class="size-8 rounded-full object-cover transition-transform duration-[250ms] sm:fullscreen:scale-125"
         src="{{ static('main/assistant-avatar.webp') }}" alt="Assistant Avatar" />
    {% endif %}
    <div class="py-3 px-4 w-fit max-w-sm text-sm hyphens-auto whitespace-pre-wrap rounded-xl shadow transition-[background-color,font-size,line-height,padding] duration-[250ms] sm:fullscreen:py-4 sm:fullscreen:px-5 sm:fullscreen:text-lg sm:fullscreen:max-w-3xl sm:fullscreen:rounded-2xl {% if role == 'assistant' %}bg-neutral-200 dark:bg-neutral-825 rounded-bl-none sm:fullscreen:rounded-bl-none{% else %}bg-orange-300 dark:bg-amber-900 rounded-br-none sm:fullscreen:rounded-br-none{% endif %}">{{- content -}}</div>
</div>
{% endmacro %}


{% macro chat_input(name) %}
<label class="group relative flex items-center rounded-xl ps-6 pe-0 bg-neutral-100 shadow border border-transparent !bg-opacity-90 transition-[border-color,background-color,padding] duration-[250ms] has-[input:focus:placeholder-shown]:border-neutral-300 has-[:focus]:border-neutral-400 has-[input:focus]:outline-2 has-[input:focus:placeholder-shown]:outline-0 dark:bg-neutral-875 dark:border-neutral-200/5 dark:has-[input:focus:placeholder-shown]:border-neutral-200/15 dark:has-[input:focus]:border-neutral-200/50 sm:fullscreen:pe-2 sm:fullscreen:ps-7 sm:fullscreen:py-1 [&>input]:outline-none [&>input]:bg-transparent [&>input]:grow [&>input]:text-sm [&>input]:sm:fullscreen:text-lg">
    <input id="chat-input" name="{{ name }}" type="text" placeholder="Type a message..." autocomplete="off" required />
    <button type="submit" class="inline-flex justify-center items-center size-10 m-2 rounded-xl text-neutral-400 transition-colors duration-[250ms] group-has-[input:focus:placeholder-shown]:text-neutral-500 group-has-[input:focus]:text-neutral-600 dark:text-neutral-400 dark:group-has-[input:focus:placeholder-shown]:text-neutral-300 dark:group-has-[input:focus]:text-neutral-200">
        <span class="icon-[fluent--send-28-filled] size-5 transition-transform sm:fullscreen:scale-125"></span>
    </button>
    <span class="hidden group-has-[input:focus]:sm:flex group-has-[input:focus:placeholder-shown]:hidden items-center text-xs absolute -bottom-6 left-0 animate-fade tracking-wide pizza:text-neutral-100">
        <span class="icon-[mi--enter] me-1.5 text-lg translate-y-[1px] inline-block"></span>
        Press <span class="px-1 font-[monospace] translate-y-[0px] text-[0.7rem]">Enter</span> to send the message
    </span>
</label>
{% endmacro %}


{% macro chat_placeholder() %}
<div class="size-full flex flex-col items-center justify-center text-center px-4 transition-transform duration-[250ms] sm:fullscreen:scale-125 group-has-[.chat-message:not(#typing-indicator)]:hidden">
    <span class="icon-[tabler--message-chatbot-filled] size-12 text-neutral-500 dark:text-neutral-400"></span>
    <h3 class="mt-2 tracking-wide">Functional Chatbots</h3>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-2 max-w-sm">
        {{ prompt_chip('Turn on dark mode', 'icon-[ri--moon-clear-line]') }}
        {{ prompt_chip('Go fullscreen', 'icon-[majesticons--maximize]') }}
        {{ prompt_chip('Switch to pizza mode', 'icon-[fluent-emoji-flat--pizza]') }}
        {{ prompt_chip('Order a small pepperoni', 'icon-[mdi--spicy]') }}
    </div>
</div>
{% endmacro %}


{# Clickable suggestion that prefills the chat input and submits. #}
{% macro prompt_chip(text, icon_class) %}
<button type="button"
        class="inline-flex items-center gap-1.5 cursor-pointer px-3 py-1 text-xs rounded-full border border-neutral-300 dark:border-neutral-700 text-neutral-600 dark:text-neutral-300 bg-neutral-50/50 dark:bg-neutral-825/50 hover:border-orange-500 hover:text-orange-500 dark:hover:border-amber-500 dark:hover:text-amber-500 transition-colors duration-[150ms]"
        _="on click
             set #chat-input.value to '{{ text }}'
             then call #user-message-form.requestSubmit()">
    <span class="{{ icon_class }} size-3.5"></span>
    {{ text }}
</button>
{% endmacro %}


{% macro radio_label(name, value, label, icon_class, checked=False) %}
<label class="group relative inline-flex flex-col items-center w-24 text-neutral-700 dark:text-neutral-300 has-[:checked]:text-neutral-900 dark:has-[:checked]:text-neutral-50 text-sm gap-1 px-3 py-1.5 sm:px-4 sm:py-2 cursor-pointer border border-transparent ring-2 ring-transparent hover:border-neutral-500/50 dark:hover:border-neutral-400/50 has-[:checked]:border-orange-500 dark:has-[:checked]:border-amber-500 rounded-lg duration-200 select-none">
    <input name="{{ name }}" type="radio" value="{{ value }}" class="peer hidden" required {% if checked %}checked{% endif %} />
    <span class="icon-[lets-icons--check-fill] text-transparent peer-checked:text-orange-500 dark:peer-checked:text-amber-500 absolute right-2 top-2 duration-200"></span>
    <span class="{{ icon_class }} size-10 text-neutral-400 group-hover:text-neutral-500 dark:text-neutral-400 dark:group-hover:text-neutral-300 peer-checked:text-orange-500 dark:peer-checked:text-amber-500 duration-200"></span>
    <span class="peer-checked:font-[600]">{{ label }}</span>
</label>
{% endmacro %}


{% macro pizza_order(order) %}
<div class="pizza-order group/order flex items-center justify-between mb-2 cursor-pointer hover:bg-neutral-700/10 dark:hover:bg-neutral-100/10 p-4 pe-6 rounded-2xl select-none animate-fade transition-colors duration-[250ms]"
     hx-get="/pizza-orders/{{ order.id }}/update" hx-target="body" hx-swap="beforeend">
    <div class="flex items-center">
        <span class="relative inline-grid place-items-center">
            <span class="icon-[game-icons--full-pizza] size-5 sm:fullscreen:size-7 text-orange-500 dark:text-amber-500"></span>
            <span class="icon-[mingcute--loading-fill] animate-spin size-2.5 sm:fullscreen:size-3 absolute -top-2 -right-1.5 transition-[color,opacity] duration-[250ms] text-orange-500 dark:text-amber-500 group-has-[[style*='--seconds-left:_0']]/order:opacity-0 sm:fullscreen:-top-2.5"></span>
            <span class="icon-[bi--check] absolute -top-2.5 -right-2.5 text-green-700 dark:text-green-600 transition-[color,opacity] duration-[250ms] invisible opacity-0 group-has-[[style*='--seconds-left:_0']]/order:visible group-has-[[style*='--seconds-left:_0']]/order:opacity-100"></span>
            <span class="{% if order.name == 'cheese' %}icon-[ph--cheese-fill]{% elif order.name == 'pepperoni' %}icon-[mdi--spicy]{% else %}icon-[ph--plant-fill]{% endif %} absolute -bottom-2 -right-1.5 size-2.5 text-orange-500 dark:text-amber-500"></span>
        </span>
        <div class="flex flex-col mx-3">
            <span class="font-[600]">Pizza Order #{{ order.id }}</span>
            <span class="text-xs sm:text-sm">{{ order.name|title }}, {{ order.size|title }}</span>
        </div>
    </div>
    <div class="inline-flex">
        {{ pizza_order_countdown(order.seconds_left) }}
        <span class="hidden group-has-[[style*='--seconds-left:_0']]/order:block text-green-700 dark:text-green-600">Ready</span>
    </div>
</div>
{% endmacro %}


{% macro pizza_order_countdown(seconds_left) %}
<div class="inline-flex leading-[1em] overflow-y-hidden has-[[style*='--seconds-left:_0']]:hidden">
    <span class="inline-block h-[1em] transition-colors duration-[250ms] before:transition-all before:duration-[250ms] before:text-center before:whitespace-pre before:top-[calc(var(--seconds-left)*-1em)] before:relative before:content-['00\A_01\A_02\A_03\A_04\A_05\A_06\A_07\A_08\A_09\A_10\A_11\A_12\A_13\A_14\A_15\A_16\A_17\A_18\A_19\A_20\A_21\A_22\A_23\A_24\A_25\A_26\A_27\A_28\A_29\A_30\A_31\A_32\A_33\A_34\A_35\A_36\A_37\A_38\A_39\A_40\A_41\A_42\A_43\A_44\A_45\A_46\A_47\A_48\A_49\A_50\A_51\A_52\A_53\A_54\A_55\A_56\A_57\A_58\A_59\A_60\A_61\A_62\A_63\A_64\A_65\A_66\A_67\A_68\A_69\A_70\A_71\A_72\A_73\A_74\A_75\A_76\A_77\A_78\A_79\A_80\A_81\A_82\A_83\A_84\A_85\A_86\A_87\A_88\A_89\A_90\A_91\A_92\A_93\A_94\A_95\A_96\A_97\A_98\A_99\A_100\A_101\A_102\A_103\A_104\A_105\A_106\A_107\A_108\A_109\A_110\A_111\A_112\A_113\A_114\A_115\A_116\A_117\A_118\A_119\A_120\A_121\A_122\A_123\A_124\A_125\A_126\A_127\A_128\A_129\A_130\A_131\A_132\A_133\A_134\A_135\A_136\A_137\A_138\A_139\A_140\A_141\A_142\A_143\A_144\A_145\A_146\A_147\A_148\A_149\A_150\A_151\A_152\A_153\A_154\A_155\A_156\A_157\A_158\A_159\A_160\A_161\A_162\A_163\A_164\A_165\A_166\A_167\A_168\A_169\A_170\A_171\A_172\A_173\A_174\A_175\A_176\A_177\A_178\A_179\A_180\A_181\A_182\A_183\A_184\A_185\A_186\A_187\A_188\A_189\A_190\A_191\A_192\A_193\A_194\A_195\A_196\A_197\A_198\A_199\A_200']"
          style="--seconds-left: {{ seconds_left }};"
          _="init
                set seconds_left to {{ seconds_left }}
                repeat until seconds_left is 0
                    wait 1s
                    set seconds_left to seconds_left - 1
                    me.style.setProperty('--seconds-left', seconds_left)"
    ></span>
</div>
{% endmacro %}


{% macro pizza_order_placeholder() %}
<button type="button"
        class="absolute inset-0 size-full group block cursor-pointer rounded-2xl border-2 border-dashed border-neutral-400 dark:border-neutral-500 text-center text-neutral-500 dark:text-neutral-300 hover:border-orange-500 hover:text-orange-500 hover:bg-orange-500/5 dark:hover:border-amber-500 dark:hover:text-amber-500 dark:hover:bg-amber-500/10 focus:border-orange-500 dark:focus:border-amber-500 duration-200 whitespace-nowrap transition-colors group-has-[.pizza-order]:hidden"
        hx-get="/pizza-orders/add" hx-target="body" hx-swap="beforeend">
    <span class="mx-auto relative text-neutral-500 group-hover:text-orange-500 group-focus:text-orange-500 dark:text-neutral-300 dark:group-hover:text-amber-500 dark:group-focus:text-amber-500 transition-[color,transform] sm:fullscreen:scale-125 group-hover:scale-110 duration-[250ms]">
        <span class="icon-[game-icons--full-pizza] size-12"></span>
        <span class="icon-[ic--baseline-plus] size-5 absolute -top-10 -right-2"></span>
    </span>
    <span class="mt-2 block text-sm font-[600] transition-transform sm:fullscreen:scale-125 duration-[250ms]">Create pizza order</span>
</button>
{% endmacro %}
