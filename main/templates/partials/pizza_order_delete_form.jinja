<dialog class="[animation:fade_0.2s_both] bg-transparent text-neutral-800 dark:text-neutral-300 backdrop:backdrop-blur-lg backdrop:bg-black/50"
        hx-on::load="this.showModal()" hx-on:close="this.remove()">

    <div class="flex flex-col p-6 px-8 bg-neutral-100 border border-transparent shadow rounded-2xl transition-colors duration-[250ms] dark:bg-[#161C1D] dark:border-neutral-200/5">

        <h3 class="sm:text-lg font-[500] mb-4">Delete Pizza Order #{{ order_id }}</h3>
        <p class="mb-8">Are you sure you want to delete this pizza order?</p>

        <div class="flex justify-end items-center gap-2">
            <form method="dialog" class="w-1/3">
                <button class="w-full hover:bg-neutral-200 dark:hover:bg-neutral-700 dark:text-white text-black inline-flex items-center justify-center px-3 py-1.5 mt-auto rounded-lg transition-colors duration-[250ms] font-[500] whitespace-nowrap">
                    Cancel
                </button>
            </form>
            <button type="button" class="w-1/3 bg-red-500 hover:bg-red-600 dark:bg-red-500 dark:hover:bg-red-400 text-white dark:text-black inline-flex items-center justify-center px-3 py-1.5 mt-auto rounded-lg transition-colors duration-[250ms] font-[500] whitespace-nowrap"
                    hx-post="/pizza-orders/{{ order_id }}/delete" hx-on::after-request="htmx.find('dialog').close()">
                Yes
            </button>
        </div>
    </div>

    <form method="dialog" class="fixed inset-0 cursor-pointer -z-10" hx-on:click="this.submit()"></form>
</dialog>
