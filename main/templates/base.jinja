<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Functional Chatbots | DjangoCon Europe 2024 | Christian Tanul</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" href="{{ static('main/favicon.svg') }}" type="image/svg+xml" />

    <link rel="stylesheet" href="{{ static('main/css/output.css') }}" />

    <script defer src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script src="https://unpkg.com/hyperscript.org@0.9.13"></script>
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
    <style>iconify-icon { display: inline-block; width: 1em; height: 1em; }</style>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;700&display=swap" rel="stylesheet">
</head>

<body class="font-sans text-neutral-800 dark:text-neutral-100">

<div class="*:fixed *:inset-0 *:transition-opacity *:duration-[250ms] *:size-full">
    <div id="background-dark" class="opacity-0 dark:opacity-100 bg-[linear-gradient(175deg,rgb(18,23,24)_50%,rgb(29,38,49)_100%)]"></div>
    <div id="background-light" class="opacity-100 dark:opacity-0 bg-gradient-to-br from-neutral-100 to-neutral-300"></div>
    <video id="background-pizza" src="{{ static('main/pizza-footage.webm') }}" class="object-cover opacity-0 pizza:opacity-100 dark:saturate-50 brightness-50 duration-200 after:content-[''] relative after:absolute after:size-full after:opacity-20 after:bg-black" muted autoplay loop playsinline></video>
</div>

<div class="fixed top-4 left-6 sm:left-1/2 sm:-translate-x-1/2 h-fit max-h-[80px] overflow-hidden transition-[max-height,margin-bottom] duration-[250ms] flex flex-col sm:items-center justify-center mb-3 sm:mb-6 sm:fullscreen:max-h-0 sm:fullscreen:mb-0 pizza:text-neutral-300">
    <a href="https://github.com/scriptogre/functional-chatbots" target="_blank" rel="noopener" class="sm:text-xl transition-[margin-bottom] duration-[250ms] mb-1.5 sm:mb-3">
        <code>Functional Chatbots · DjangoCon Europe 2024</code>
    </a>
</div>

<main class="flex flex-col sm:flex-row justify-center items-start sm:items-center h-screen py-14 px-6 z-10 [animation:fade_0.5s_both]">
    {% block content %}{% endblock %}
</main>

<footer class="flex items-center fixed right-1/2 translate-x-1/2 bottom-4 gap-2 sm:fullscreen:right-6 sm:fullscreen:translate-x-0 transition-[bottom,right,transform] duration-[250ms]">
    <a href="https://github.com/scriptogre" target="_blank" rel="noopener" class="p-1 text-neutral-500 hover:text-neutral-600 dark:text-neutral-400 hover:dark:text-neutral-200 pizza:text-neutral-300 hover:pizza:text-neutral-50 transition-colors duration-[250ms]" aria-label="Github">
        <iconify-icon icon="akar-icons:github-fill" class="translate-y-1"></iconify-icon>
    </a>
    <a href="https://www.linkedin.com/in/christian-tanul-94333a17a/" target="_blank" rel="noopener" class="p-1 text-neutral-500 hover:text-neutral-600 dark:text-neutral-400 hover:dark:text-neutral-200 pizza:text-neutral-300 hover:pizza:text-neutral-50 transition-colors duration-[250ms]" aria-label="LinkedIn">
        <iconify-icon icon="akar-icons:linkedin-fill" class="translate-y-1"></iconify-icon>
    </a>
</footer>

</body>
</html>
