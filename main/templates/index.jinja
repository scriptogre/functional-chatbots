{% extends "base.jinja" %}
{% from "partials/_macros.jinja" import chat_message, chat_input, chat_placeholder, pizza_order, pizza_order_placeholder, toggle_pill %}

{% block content %}

<!-- Pizza Orders -->
<div class="size-full max-h-[0px] max-sm:pizza:max-h-[33%] sm:max-h-full sm:h-[400px] sm:fullscreen:h-full sm:max-w-0 sm:pizza:max-w-[400px] flex-col gap-3 pizza:mb-3 sm:pizza:mb-0 sm:pizza:me-3 opacity-0 pizza:opacity-100 pointer-events-none pizza:pointer-events-auto transition-[height,max-width,max-height] will-change-[height,max-height,max-width]">

    <div class="relative flex flex-col p-6 overflow-y-auto size-full bg-neutral-100 border border-transparent shadow rounded-2xl [scrollbar-width:none] [-ms-overflow-style:none] scroll-smooth transition-colors duration-[250ms] dark:bg-neutral-875 dark:border-neutral-200/5 !bg-opacity-90 group">

        <div id="pizza-orders" class="flex flex-col max-h-[calc(100%-3.5rem)] overflow-scroll"
             hx-get="/pizza-orders" hx-select="#pizza-orders" hx-swap="outerHTML" hx-trigger="pizzaOrdersUpdated from:body" hx-disinherit="hx-select">
            {% for order in pizza_orders|default([]) %}
                {{ pizza_order(order) }}
            {% endfor %}
        </div>

        {# Default hidden; show as inline-flex only when an order exists.
           Don't combine `hidden` + `inline-flex` directly: Tailwind v4
           emits .inline-flex after .hidden so the latter never wins. #}
        <button id="add-pizza-order-button" type="button"
                class="hidden cursor-pointer group-has-[.pizza-order]:inline-flex text-black bg-orange-500 hover:bg-orange-600 dark:bg-amber-500 dark:hover:bg-amber-400 items-center justify-center px-3 py-1.5 mt-auto rounded-lg transition-colors duration-[250ms] font-[600] whitespace-nowrap"
                hx-get="/pizza-orders/add" hx-target="body" hx-swap="beforeend">
            Add Pizza Order
        </button>

        {{ pizza_order_placeholder() }}

    </div>
</div>

<!-- Chat -->
<div class="flex flex-col gap-3 w-full h-full sm:max-w-[500px] sm:max-h-[400px] sm:fullscreen:max-w-full sm:fullscreen:max-h-full max-w-xl transition-[max-width,max-height]">

    {# Reverse-flex trick: column-reverse + afterbegin keeps the latest
       message anchored to the visible bottom without manual scroll. DOM
       order is newest-first; column-reverse flips it visually back to
       oldest-on-top / newest-on-bottom. Empty state uses justify-center
       so the placeholder sits in the middle; once a real message exists,
       :has() flips justify-content to flex-start (which renders at
       main-start = bottom in column-reverse, the desired stack). #}
    <div id="chat-container" class="flex flex-col-reverse size-full p-4 bg-neutral-100 border border-transparent shadow rounded-2xl overflow-y-auto [scrollbar-width:none] [-ms-overflow-style:none] scroll-smooth transition-colors duration-[250ms] dark:bg-neutral-875 dark:border-neutral-200/5 bg-opacity-95 dark:bg-opacity-95 sm:p-8 justify-center has-[.chat-message:not(#typing-indicator)]:justify-start group">

        {# Typing indicator pinned to the visible bottom while in flight.
           order:-1 places it at main-start (bottom) in column-reverse. #}
        <div id="typing-indicator"
             class="chat-message hidden [order:-1] [body:has(#trigger-assistant.htmx-request)_&]:inline-flex items-end mb-4 gap-3 flex-row [animation:fade_0.5s_both_0.25s]">
            <img class="size-8 rounded-full object-cover transition-transform duration-[250ms]"
                 src="{{ static('main/assistant-avatar.webp') }}" alt="Assistant Avatar" />
            <div class="py-3 px-4 w-fit max-w-sm text-sm hyphens-auto whitespace-pre-wrap rounded-xl shadow transition-[background-color,font-size,line-height,padding] duration-[250ms] bg-neutral-200 dark:bg-neutral-825 rounded-bl-none">Typing...</div>
        </div>

        {# Server-rendered history is oldest-first in session.chat_messages;
           reverse it so newest is DOM-first, which becomes visual-bottom. #}
        {% for msg in (chat_messages|default([]))|reverse %}
            {{ chat_message(role=msg.role, content=msg.content) }}
        {% endfor %}

        {{ chat_placeholder() }}

    </div>

    <form id="user-message-form"
          hx-post="/add-user-message"
          hx-target="#chat-container"
          hx-swap="afterbegin"
          hx-on::after-request="htmx.find('input[name=message]').value = ''">
        {{ chat_input(name='message') }}
    </form>

    <input id="trigger-assistant" type="hidden"
           hx-post="/add-assistant-message"
           hx-target="#chat-container"
           hx-swap="afterbegin"
           hx-trigger="generateAssistantMessage from:body" />

    {# Mode pills, content-sized, centered under the chat input. They share
       the same gap-3 as everything else in the chat column so the spacing
       reads as one tight cluster: chat -> input -> pills. #}
    <div class="mx-auto inline-flex items-center gap-1 p-1 rounded-2xl bg-neutral-100 dark:bg-neutral-875 border border-transparent dark:border-neutral-200/5 shadow pizza:bg-black/30 pizza:border-white/10">
        {{ toggle_pill(
            id='dark-mode-toggle', name='is_dark_mode', checked=is_dark_mode|default(False),
            label='Dark', icon_class='icon-[ri--moon-clear-line]',
            hx_post='/toggle-dark-mode',
            hx_trigger='click, toggleDarkMode from:body delay:100ms'
        ) }}
        {{ toggle_pill(
            id='fullscreen-mode-toggle', name='is_fullscreen_mode', checked=is_fullscreen_mode|default(False),
            label='Fullscreen', icon_class='icon-[majesticons--maximize]',
            hx_post='/toggle-fullscreen-mode',
            hx_trigger='click, toggleFullscreenMode from:body delay:200ms'
        ) }}
        {{ toggle_pill(
            id='pizza-mode-toggle', name='is_pizza_mode', checked=is_pizza_mode|default(False),
            label='Pizza', icon_class='icon-[game-icons--full-pizza]',
            hx_post='/toggle-pizza-mode',
            hx_trigger='click, togglePizzaMode from:body delay:300ms'
        ) }}
    </div>
</div>

{% endblock %}
