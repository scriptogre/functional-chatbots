# Rename to `.env` and fill in the values below.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-secret-not-for-production
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=

# Create a free account at https://console.groq.com/login
# Then an API key at https://console.groq.com/keys
GROQ_API_KEY=set_your_api_key_here

# Browse Groq models: https://console.groq.com/docs/models
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
